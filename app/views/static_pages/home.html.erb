

<div data-controller="toggle">

    <button data-action="toggle#toggle">Choose a car</button><br><br>
    
    <div data-toggle-target="list" hidden>
        <%= select_tag :cars, options_for_select(["Tesla", "BMW", "Honda", "BYD", "Ferrary", "Mercedes"]), { include_blank: true } %>
    </div><br><br>

    <div data-action="click->toggle#switch" data-toggle-target="invisible">Click me and I will dissapear!</div><br><br>
    <div data-toggle-target="visible" hidden>
        Hey, I am here!
    </div><br><br>

    <div>Checkbox</div><br><br>
    <div class="item">
        <label><input type="checkbox" data-action="change->toggle#highlight">IT</label>
    </div>

    <div class="item">
        <label><input type="checkbox" data-action="change->toggle#highlight">Engineering</label>
    </div>

    <div class="item">
        <label><input type="checkbox" data-action="change->toggle#highlight">3D Design</label>
    </div>

    <div class="item">
        <label><input type="checkbox" data-action="change->toggle#highlight">Gaming</label>
    </div>


</div>


